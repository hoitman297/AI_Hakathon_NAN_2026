# 이 파일을 복사해서 같은 위치에 application-local.yml로 만들고
# 아래 값을 본인 로컬 환경에 맞게 채워주세요.
# (application-local.yml은 .gitignore에 포함되어 커밋되지 않습니다)
#
# docker-compose로 띄운 로컬 MySQL을 쓰는 경우: 아래 기본값만 채우면 됩니다
# (DB_HOST/DB_PORT/DB_SSL_MODE는 생략 시 localhost:3306, SSL 미강제로 동작합니다).
#
# 팀 공유 DB 서버(Aiven 등 SSL 필수 접속)를 쓰는 경우: DB_HOST/DB_PORT를 서버 값으로,
# DB_SSL_MODE를 REQUIRED로 지정해주세요. 팀 채널에서 공유받은 계정/서버 정보를 쓰세요.

DB_USERNAME: game_user
DB_PASSWORD: change_me
# DB_HOST: localhost
# DB_PORT: 3306
# DB_SSL_MODE: REQUIRED

# 실제 LLM 연동 전이라 임의 문자열이어도 서버 실행에는 문제없음
LLM_API_KEY: change_me

# backend -> llm-proxy 내부 API 호출을 검증하는 공유 비밀키.
# backend/application-local.yml의 INTERNAL_API_KEY와 반드시 같은 값이어야 함.
INTERNAL_API_KEY: change_me
